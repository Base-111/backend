{
  "realm": "${AUTH_REALM}",
  "enabled": true,
  "clients": [
    {
      "clientId": "${AUTH_CLIENT_ID}",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${AUTH_CLIENT_SECRET}",
      "redirectUris": ["*"],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "attributes": {
        "access.token.lifespan": 300
      }
    }
  ],
  "users": [
    {
      "username": "daniel",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "daniel"
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}